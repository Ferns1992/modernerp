# ModernERP environment variables (copy to .env and adjust).

# HTTP port (default 4000)
PORT=4000

# SQLite database file. Inside Docker use /data/pos.db (persistent volume).
DATABASE_PATH=/data/pos.db

# Session cookie settings
SESSION_DAYS=7
# Set true when served over HTTPS (defaults to true in production)
COOKIE_SECURE=true
# Random 64-char secret used to harden cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# Initial admin account. Only applied on a brand-new (empty) database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Login rate limiting (max attempts per 15 minutes per IP)
LOGIN_MAX=10

# Report timezone offset in hours (e.g. 8 for Philippines)
TZ_OFFSET_HOURS=8